# At least one of these is required for AI features. Both are optional — the app falls back to demo mode without them.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL
DATABASE_URL=

# SOS delivery. Configure at least one provider before enabling SOS in production.
SOS_FROM_EMAIL=
AUTH_FROM_EMAIL=
RESEND_API_KEY=
SOS_RETENTION_DAYS=30
RETENTION_JOB_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
